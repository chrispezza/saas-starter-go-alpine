package partials

import "fmt"

// IsolationProps drives the RLS proof panel on the flashcards page
// (ADR-034): who Postgres thinks the visitor is, and — once Ran — how many
// of the visitor's own rows the same query returned to them and to a
// freshly minted stranger.
type IsolationProps struct {
	UserID      string // truncated users.id
	Sub         string // truncated auth.uid() of the requester
	Role        string
	IsAnonymous bool
	HasCards    bool

	Ran          bool
	OwnRows      int
	StrangerSub  string
	StrangerRows int
}

// isolationPolicySQL is the policy the check exercises, quoted from
// migrations/000003_add_quiz_flashcards.up.sql (kept in sync by hand like
// the explainer's source peeks).
const isolationPolicySQL = `ALTER TABLE flashcards FORCE ROW LEVEL SECURITY;
CREATE POLICY flashcards_self_access ON flashcards
    USING      (EXISTS (SELECT 1 FROM users u WHERE u.id = flashcards.user_id AND u.auth_id = auth.uid()::text))
    WITH CHECK (EXISTS (SELECT 1 FROM users u WHERE u.id = flashcards.user_id AND u.auth_id = auth.uid()::text));

-- what the repository runs, for both reads:
BEGIN;
SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claims', '{"sub": "<identity>", ...}', true);
SELECT ... FROM flashcards WHERE user_id = $1 ORDER BY created_at DESC;  -- $1 = your users.id, both times
COMMIT;`

func yesNo(b bool) string {
	if b {
		return "yes"
	}
	return "no"
}

func rowsWord(n int) string {
	if n == 1 {
		return "1 row"
	}
	return fmt.Sprintf("%d rows", n)
}

// IsolationPanel is the whole surface: identity facts, the policy, and the
// result slot (or the call to action that fills it).
templ IsolationPanel(props IsolationProps) {
	<section data-testid="isolation-panel" aria-labelledby="isolation-heading" class="mt-10 bg-surface rounded-lg shadow-md p-6">
		<p class="text-sm uppercase tracking-wide text-muted-foreground mb-1">Row Level Security, witnessed</p>
		<h2 id="isolation-heading" class="text-xl font-semibold mb-2">Run your own query as a stranger</h2>
		<p class="text-sm text-muted-foreground mb-4">
			The list above came from one query — <code class="text-xs px-1 rounded bg-primary/10 text-link">ListFlashcardsByUser(user_id = yours)</code> —
			inside a transaction that carried your identity. The check runs the same query, through the same repository,
			with the same <code class="text-xs px-1 rounded bg-primary/10 text-link">user_id</code>, but under a freshly minted identity nobody owns.
			Postgres decides what comes back, not a <code class="text-xs px-1 rounded bg-primary/10 text-link">WHERE</code> clause.
		</p>
		<dl class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm mb-4">
			<div>
				<dt class="text-xs uppercase tracking-wide text-muted-foreground">users.id</dt>
				<dd class="font-mono">{ props.UserID }</dd>
			</div>
			<div>
				<dt class="text-xs uppercase tracking-wide text-muted-foreground">auth.uid()</dt>
				<dd class="font-mono">{ props.Sub }</dd>
			</div>
			<div>
				<dt class="text-xs uppercase tracking-wide text-muted-foreground">role</dt>
				<dd class="font-mono">{ props.Role }</dd>
			</div>
			<div>
				<dt class="text-xs uppercase tracking-wide text-muted-foreground">anonymous</dt>
				<dd class="font-mono">{ yesNo(props.IsAnonymous) }</dd>
			</div>
		</dl>
		<details class="mb-4 rounded-md border border-border bg-background/60 open:bg-surface-hover">
			<summary class="cursor-pointer select-none px-4 py-2 text-sm font-medium text-link hover:underline">
				The policy and the transaction — <code class="text-xs text-foreground">migrations/000003 · internal/repository/postgres/scope.go</code>
			</summary>
			<pre class="p-4 text-xs overflow-x-auto border-t border-border"><code>{ isolationPolicySQL }</code></pre>
		</details>
		<div id="isolation-result" aria-live="polite">
			if props.Ran {
				@IsolationResult(props)
			} else if !props.HasCards {
				<p class="text-sm text-muted-foreground">
					Nothing to prove yet — both reads would be empty. Miss a question on the
					<a href="/learn/quiz" class="text-link underline">quiz</a>, save the flashcard, and come back to run the check.
				</p>
			} else {
				<a
					href="/learn/flashcards?check=1"
					hx-get="/learn/flashcards/isolation"
					hx-target="#isolation-result"
					hx-swap="innerHTML"
					class="btn btn-primary inline-block"
				>
					Run the isolation check
				</a>
			}
		</div>
	</section>
}

// IsolationResult renders both reads side by side and the verdict. A
// standalone fragment for the HTMX swap.
templ IsolationResult(props IsolationProps) {
	<div
		data-testid="isolation-result"
		data-own-rows={ fmt.Sprintf("%d", props.OwnRows) }
		data-stranger-rows={ fmt.Sprintf("%d", props.StrangerRows) }
		role="status"
	>
		<div class="grid gap-3 sm:grid-cols-2">
			<div class="rounded-md border border-border p-4">
				<p class="text-xs uppercase tracking-wide text-muted-foreground">As you</p>
				<p class="font-mono text-xs text-muted-foreground mt-1">{ "auth.uid() = " + props.Sub }</p>
				<p class="text-2xl font-semibold mt-2 tabular-nums">{ rowsWord(props.OwnRows) }</p>
			</div>
			<div class="rounded-md border border-border p-4">
				<p class="text-xs uppercase tracking-wide text-muted-foreground">As a stranger</p>
				<p class="font-mono text-xs text-muted-foreground mt-1">{ "auth.uid() = " + props.StrangerSub }</p>
				<p class="text-2xl font-semibold mt-2 tabular-nums">{ rowsWord(props.StrangerRows) }</p>
			</div>
		</div>
		if props.OwnRows > 0 && props.StrangerRows == 0 {
			<p class="mt-4 p-3 rounded-md bg-success/10 text-success text-sm">
				Same SQL, same user_id, different auth.uid() — Postgres returned nothing to the stranger.
				That is the policy <code class="text-xs">flashcards_self_access</code> refusing, not application code remembering to filter.
			</p>
		} else if props.OwnRows == 0 {
			<p class="mt-4 p-3 rounded-md bg-surface-hover text-muted-foreground text-sm">
				You have no cards, so both reads are empty. Save one from the quiz and run the check again.
			</p>
		} else {
			<p class="mt-4 p-3 rounded-md bg-danger/10 text-danger text-sm" role="alert">
				Isolation failed: a stranger identity could read your rows. This must never happen — please report it.
			</p>
		}
		<p class="mt-3 text-sm">
			<a href="/learn/flashcards?check=1" hx-get="/learn/flashcards/isolation" hx-target="#isolation-result" hx-swap="innerHTML" class="text-link underline">Run it again</a>
			<span class="text-muted-foreground"> — a new stranger identity each time.</span>
		</p>
	</div>
}
